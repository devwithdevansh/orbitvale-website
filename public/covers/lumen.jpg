<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 560 360" width="560" height="360">
  <defs>
    <radialGradient id="bg" cx="50%" cy="80%" r="80%">
      <stop offset="0%" stop-color="#0d100a"/>
      <stop offset="100%" stop-color="#08090b"/>
    </radialGradient>
    <radialGradient id="beam" cx="50%" cy="100%" r="80%">
      <stop offset="0%" stop-color="#a3e635" stop-opacity="0.35"/>
      <stop offset="100%" stop-color="#a3e635" stop-opacity="0"/>
    </radialGradient>
    <filter id="blur"><feGaussianBlur stdDeviation="14"/></filter>
    <filter id="glow"><feGaussianBlur stdDeviation="3"/></filter>
  </defs>
  <rect width="560" height="360" fill="url(#bg)"/>
  <ellipse cx="280" cy="340" rx="260" ry="140" fill="url(#beam)" filter="url(#blur)"/>
  <!-- data bars rising from base -->
  <rect x="80" y="200" width="28" height="140" fill="#a3e635" fill-opacity="0.5"/>
  <rect x="122" y="160" width="28" height="180" fill="#a3e635" fill-opacity="0.65"/>
  <rect x="164" y="130" width="28" height="210" fill="#a3e635" fill-opacity="0.75"/>
  <rect x="206" y="100" width="28" height="240" fill="#a3e635" fill-opacity="0.8"/>
  <rect x="248" y="80" width="28" height="260" fill="#7ff3d0" fill-opacity="0.85"/>
  <rect x="290" y="110" width="28" height="230" fill="#a3e635" fill-opacity="0.75"/>
  <rect x="332" y="145" width="28" height="195" fill="#a3e635" fill-opacity="0.65"/>
  <rect x="374" y="180" width="28" height="160" fill="#a3e635" fill-opacity="0.5"/>
  <rect x="416" y="220" width="28" height="120" fill="#a3e635" fill-opacity="0.35"/>
  <!-- line chart on top -->
  <polyline points="80,200 122,160 164,130 206,100 248,80 290,110 332,145 374,180 416,220" fill="none" stroke="#ffffff" stroke-width="1.5" stroke-opacity="0.5"/>
  <text x="32" y="52" font-family="ui-monospace,monospace" font-size="9" letter-spacing="0.25em" fill="#a3e635" fill-opacity="0.7">LUMEN</text>
  <text x="32" y="330" font-family="ui-monospace,monospace" font-size="8" letter-spacing="0.18em" fill="#ffffff" fill-opacity="0.25">04 / ANALYTICS DASH</text>
</svg>
